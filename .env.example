# Supabase → Project Settings → API. Mientras estén vacías, la tienda usa los datos de ejemplo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave secreta (service_role). NUNCA la compartas ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Correos que pueden entrar al panel /admin, separados por coma.
ADMIN_EMAILS=

# Dirección pública de la tienda, para los enlaces de seguimiento que se mandan por WhatsApp.
# Ej. https://stockherramienta.mx  (si la dejas vacía se usa la dirección con la que se abrió la página)
NEXT_PUBLIC_SITE_URL=

# Correos al cliente (pedido recibido, pago confirmado, preparando, enviado…) con https://resend.com
# Si la dejas vacía, los correos quedan en MODO PRUEBA: no salen, pero los ves en el panel dentro de cada pedido.
RESEND_API_KEY=
# Remitente. Con onboarding@resend.dev Resend solo deja mandar a TU propio correo (el de tu cuenta de Resend);
# para mandar a cualquier cliente hay que verificar tu dominio en Resend y poner ej. pedidos@stockherramienta.mx
EMAIL_FROM=Stock Herramienta <onboarding@resend.dev>
